---
import { urlForImage } from '../../sanity/urlForImage';

const {asset, alt} = Astro.props.node

const url = urlForImage(asset).width(1600).url()
const webp800Url = urlForImage(asset).width(800).format('webp').url()
const webp1600Url = urlForImage(asset).width(1600).format('webp').url()
---

<picture>
  <source
    srcset={`${webp800Url} 800w, ${webp1600Url} 1600w`}
    sizes="(min-width: 1024px) calc(100vw - 16rem), calc(100vw - 4rem)"
    type="image/webp"
  />
  <img
    class="responsive__img"
    src={url}
    alt={alt}
    loading="lazy"
    decoding="async"
  />
</picture>
